# On Hostinger, save this as  domains/mytransfertours.com/mtt-config/<site folder>/.env
# e.g. mtt-config/dev/.env for the folder public_html/dev. Outside public_html, so never downloadable.
# Leave APP_KEY empty: it is generated automatically on the first deploy. Never commit the real .env.

APP_NAME=MyTransferTours
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_URL=https://dev.mytransfertours.com
APP_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
# sync = emails send instantly during the request (shared hosting cron is hourly).
# Switch to "database" on a VPS with a queue worker.
QUEUE_CONNECTION=sync

# Admin panel address: https://<site>/<ADMIN_PATH>. Pick something hard to guess.
ADMIN_PATH=
# First admin login. Created on the next deploy with a temporary password (shown once).
ADMIN_EMAIL=

# Secret for https://<site>/_deploy/<token>, which runs migrations right after a deploy.
# Use a long random value. Leave empty to disable.
DEPLOY_TOKEN=
FILESYSTEM_DISK=local

# IONOS mailbox (username = full email address). Port 587 + MAIL_SCHEME=smtp if 465 is blocked.
MAIL_MAILER=smtp
MAIL_HOST=smtp.ionos.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=bookings@mytransfertours.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=bookings@mytransfertours.com
MAIL_FROM_NAME="${APP_NAME}"

# On dev, every supplier email is redirected here instead of the real supplier.
MAIL_TEST_RECIPIENT=

# Stripe: use TEST keys (sk_test_...) on dev, LIVE keys only on the live site
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Google sign-in (Google Cloud Console > OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Supplier reminders: hours between reminders (max 2, then your team is alerted)
SUPPLIER_REMINDER_HOURS=4
# Customers can change flight/hotel/notes online until this many hours before the service
CUSTOMER_EDIT_CUTOFF_HOURS=24
